  "script": "// Use native Desk routes and dialogs; this block never writes business data.\n(() => {\n    const ownWidget = root_element.host.closest(\".custom-block-widget-box\");\n    if (ownWidget) {\n        Object.assign(ownWidget.style, { padding: \"0\", background: \"transparent\", border: \"0\", boxShadow: \"none\" });\n    }\n    // Recover existing Desk sessions even when their icon script is cached.\n    function ensureTheme() {\n        if (frappe.restaurant_theme_ready) return frappe.restaurant_theme_ready;\n        const styleUrl = \"/assets/restaurant/css/restaurant_theme.css?v=20261105.4\";\n        const scriptUrl = \"/assets/restaurant/js/restaurant_theme.js?v=20261105.4\";\n        const styleReady = new Promise((resolve, reject) => {\n            let link = [...document.querySelectorAll('link[rel=\"stylesheet\"]')].find(node => node.href === new URL(styleUrl, location.href).href);\n            if (link?.sheet) return resolve();\n            // A connected link without a sheet may have failed before listeners existed.\n            if (link) { link.remove(); link = null; }\n            if (!link) {\n                link = document.createElement(\"link\");\n                link.rel = \"stylesheet\";\n                link.href = styleUrl;\n            }\n            link.addEventListener(\"load\", resolve, { once: true });\n            link.addEventListener(\"error\", () => {\n                link.remove();\n                reject(new Error(\"Restaurant theme stylesheet failed to load\"));\n            }, { once: true });\n            if (!link.isConnected) document.head.appendChild(link);\n        });\n        const scriptReady = new Promise((resolve, reject) => {\n            if (frappe.restaurant_theme) return resolve();\n            const script = document.createElement(\"script\");\n            script.src = scriptUrl;\n            script.addEventListener(\"load\", resolve, { once: true });\n            script.addEventListener(\"error\", () => {\n                script.remove();\n                reject(new Error(\"Restaurant theme script failed to load\"));\n            }, { once: true });\n            document.head.appendChild(script);\n        });\n        const ready = Promise.all([styleReady, scriptReady]).then(() => {\n            if (!frappe.restaurant_theme) throw new Error(\"Restaurant theme did not initialize\");\n            frappe.restaurant_theme.refresh();\n        });\n        frappe.restaurant_theme_ready = ready;\n        ready.catch(error => {\n            delete frappe.restaurant_theme_ready;\n            console.error(\"Restaurant theme assets failed to load\", error);\n        });\n        return ready;\n    }\n    ensureTheme();\n    const routes = {\n        pos: { route: [\"restaurant-pos\"] },\n        accounts: { route: [\"List\", \"Restaurant Order\"] },\n        \"new-account\": { route: [\"restaurant-pos\"] },\n        kitchen: { route: [\"restaurant-kds\"] },\n        waiters: { route: [\"List\", \"Employee\"], filters: { designation: \"Mesero\", status: [\"in\", [\"Active\", \"Inactive\", \"Suspended\", \"Left\"]] } },\n        locations: { route: [\"restaurant-location\"] },\n        tickets: { route: [\"restaurant-commands\"] },\n        tables: { route: [\"List\", \"Restaurant Table\"] },\n        \"table-map\": { route: [\"restaurant-table-map\"] },\n        items: { route: [\"List\", \"Item\"] },\n        groups: { route: [\"Tree\", \"Item Group\"] },\n        prices: { route: [\"List\", \"Item Price\"] },\n        \"preparation-stages\": { route: [\"List\", \"Restaurant Preparation Stage\"] },\n        \"payment-methods\": { route: [\"List\", \"Mode of Payment\"] },\n        customers: { route: [\"List\", \"Customer\"] },\n        branches: { route: [\"List\", \"Branch\"] },\n        \"price-lists\": { route: [\"List\", \"Price List\"] },\n        uoms: { route: [\"List\", \"UOM\"] },\n        \"sales-analytics\": { route: [\"query-report\", \"Sales Analytics\"] },\n        \"sales-register\": { route: [\"query-report\", \"Sales Register\"] },\n        \"item-sales\": { route: [\"query-report\", \"Item-wise Sales Register\"] },\n    };\n    async function openRoute(action) {\n        if (action === \"welcome\") {\n            window.location.assign(\"/restaurant-welcome\");\n            return;\n        }\n        const destination = routes[action];\n        if (!destination) return;\n        try { await ensureTheme(); }\n        catch (error) { /* A visual failure must never block native catalog navigation. */ }\n        frappe.restaurant_item_navigation = action === \"items\";\n        frappe.restaurant_theme?.enter(destination.route);\n        frappe.route_options = destination.filters ? { ...destination.filters } : null;\n        frappe.set_route(...destination.route);\n    }\n    function openOptions(kind) {\n        const isSettings = kind === \"settings\";\n        const options = isSettings\n            ? [[\"branches\", \"Sucursales\"], [\"price-lists\", \"Listas de precios\"], [\"uoms\", \"Unidades de medida\"], [\"welcome\", \"Bienvenida\"]]\n            : [[\"sales-analytics\", \"Análisis de ventas\"], [\"sales-register\", \"Registro de ventas\"], [\"item-sales\", \"Ventas por producto\"]];\n        const content = document.createElement(\"div\");\n        content.className = \"d-grid\";\n        content.style.cssText = \"display:grid;gap:10px;padding:4px 0\";\n        const hint = document.createElement(\"p\");\n        hint.className = \"text-muted\";\n        hint.textContent = isSettings\n            ? \"Administra los catálogos disponibles. Mesas, turnos e impresoras se habilitarán en una próxima etapa.\"\n            : \"Consulta los reportes nativos de LEAF y selecciona la empresa y el período que deseas analizar.\";\n        content.appendChild(hint);\n        const dialog = new frappe.ui.Dialog({\n            title: isSettings ? \"Configuración del restaurante\" : \"Reportes\",\n            fields: [{ fieldname: \"options\", fieldtype: \"HTML\" }],\n        });\n        options.forEach(([action, label]) => {\n            const button = document.createElement(\"button\");\n            button.type = \"button\";\n            button.className = \"btn btn-default text-left\";\n            button.style.minHeight = \"44px\";\n            button.textContent = label;\n            button.addEventListener(\"click\", () => { dialog.hide(); openRoute(action); });\n            content.appendChild(button);\n        });\n        dialog.fields_dict.options.$wrapper[0].appendChild(content);\n        dialog.show();\n    }\n    root_element.querySelector(\".lr-dashboard\").addEventListener(\"click\", (event) => {\n        const card = event.target.closest(\"[data-action]\");\n        if (!card) return;\n        if (card.dataset.pending === \"true\") {\n            const title = card.querySelector(\".lr-card-title\").textContent;\n            frappe.msgprint({ title, indicator: \"blue\", message: \"Esta opción está en preparación y todavía no está habilitada. Tus datos y cuentas no se han modificado.\" });\n            return;\n        }\n        const action = card.dataset.action;\n        if (action === \"settings\" || action === \"reports\") openOptions(action);\n        else openRoute(action);\n    });\n})();\n",
  "style": "/* Styles stay inside the native Workspace custom block shadow root. */\n:host { display: block; }\n.lr-dashboard { --lr-blue: #369900; --icon-stroke: currentColor; --icon-fill: transparent; color: #142137; font-family: inherit; -webkit-font-smoothing: antialiased; }\n.lr-dashboard *, .lr-dashboard *::before, .lr-dashboard *::after { box-sizing: border-box; }\n.lr-intro { margin: 0 0 20px; color: #8693a7; font-size: 13px; line-height: 1.5; }\n.lr-panel { padding: 20px; background: #fff; border: 1px solid #dcebd3; border-radius: 12px; box-shadow: 0 2px 12px rgba(25, 45, 75, .025); }\n.lr-section + .lr-section { margin-top: 18px; padding-top: 18px; border-top: 1px solid #9dca7c; }\n.lr-section-header { display: flex; align-items: center; gap: 14px; margin-bottom: 16px; }\n.lr-section-icon { display: flex; flex: 0 0 30px; width: 30px; height: 34px; align-items: center; justify-content: center; color: var(--lr-blue); }\n.lr-section-icon-featured { background: #effbe9; border-radius: 8px; }\n.lr-section-icon svg { width: 26px; height: 26px; }\n.lr-section h2 { margin: 0 0 3px; color: #142137; font-size: 16px; font-weight: 700; line-height: 1.3; letter-spacing: -.2px; }\n.lr-section-header p { margin: 0; color: #8693a7; font-size: 12.5px; line-height: 1.4; }\n.lr-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 12px; }\n.lr-card { position: relative; display: flex; align-items: center; gap: 18px; min-width: 0; min-height: 88px; padding: 13px 14px; text-align: left; color: inherit; background: #fff; border: 1px solid #e4ebf4; border-radius: 7px; box-shadow: none; cursor: pointer; font-family: inherit; transition: border-color .15s ease, background-color .15s ease, box-shadow .15s ease; -webkit-tap-highlight-color: transparent; }\n.lr-card:hover { border-color: #a4ce87; background: #fbfef8; box-shadow: 0 3px 10px rgba(47, 133, 0, .06); }\n.lr-card:active { background: #effbe9; }\n.lr-card:focus-visible { outline: 2px solid var(--lr-blue); outline-offset: 3px; }\n.lr-card-icon { display: flex; flex: 0 0 50px; width: 50px; height: 50px; align-items: center; justify-content: center; color: var(--lr-blue); background: #effbe9; border-radius: 11px; }\n.lr-card-icon svg { width: 28px; height: 28px; }\n.lr-font-icon { font-family: FontAwesome; font-style: normal; font-weight: normal; font-size: 27px; line-height: 1; text-rendering: auto; }\n.lr-card-copy { display: block; flex: 1 1 auto; min-width: 0; padding-right: 12px; }\n.lr-card-title { display: block; margin-bottom: 4px; color: #142137; font-size: 14px; font-weight: 650; line-height: 1.3; letter-spacing: -.15px; }\n.lr-card-description { display: block; color: #8592a7; font-size: 12.5px; font-weight: 400; line-height: 1.4; }\n.lr-chevron { position: absolute; display: flex; top: 15px; right: 13px; color: var(--lr-blue); }\n.lr-chevron svg { width: 15px; height: 15px; }\n@media (max-width: 1000px) { .lr-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } }\n@media (max-width: 620px) { .lr-grid { grid-template-columns: minmax(0, 1fr); } .lr-panel { padding: 16px; } .lr-card { min-height: 88px; } .lr-section-header { gap: 10px; } }\n@media (prefers-reduced-motion: reduce) { .lr-card { transition: none; } }\n"
