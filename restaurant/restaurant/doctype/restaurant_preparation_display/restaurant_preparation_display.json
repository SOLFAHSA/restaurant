{
 "doctype": "DocType",
 "name": "Restaurant Preparation Display",
 "module": "Restaurant",
 "custom": 0,
 "autoname": "hash",
 "allow_import": 1,
 "track_changes": 1,
 "engine": "InnoDB",
 "field_order": [
  "display_name",
  "description",
  "enabled",
  "pos_profiles",
  "item_groups",
  "stages",
  "auto_clear",
  "auto_clear_minutes"
 ],
 "fields": [
  {
   "fieldname": "display_name",
   "fieldtype": "Data",
   "label": "Nombre de la pantalla",
   "reqd": 1,
   "in_list_view": 1
  },
  {
   "fieldname": "description",
   "fieldtype": "Small Text",
   "label": "Descripción"
  },
  {
   "fieldname": "enabled",
   "fieldtype": "Check",
   "label": "Activa",
   "default": "1",
   "in_list_view": 1
  },
  {
   "fieldname": "pos_profiles",
   "fieldtype": "Table",
   "label": "Puntos de venta",
   "options": "Restaurant Preparation POS",
   "description": "Sin selección, incluye todos los puntos de venta permitidos."
  },
  {
   "fieldname": "item_groups",
   "fieldtype": "Table",
   "label": "Categorías de producto",
   "options": "Restaurant Command Group",
   "description": "Sin selección, incluye todas las categorías. La coincidencia es exacta; agrega los subgrupos necesarios."
  },
  {
   "fieldname": "stages",
   "fieldtype": "Table",
   "label": "Etapas de preparación",
   "options": "Restaurant Preparation Display Stage",
   "reqd": 1,
   "description": "Orden del proceso: preparación, entrega y completado. Selecciona al menos tres etapas. El orden no puede cambiar mientras existan tickets sin retirar."
  },
  {
   "fieldname": "auto_clear",
   "fieldtype": "Check",
   "label": "Eliminación automática",
   "default": "0",
   "description": "Retira del monitor los pedidos completados; conserva la orden y su historial."
  },
  {
   "fieldname": "auto_clear_minutes",
   "fieldtype": "Int",
   "label": "Minutos para retirar pedidos",
   "default": "10",
   "non_negative": 1,
   "depends_on": "eval:doc.auto_clear",
   "mandatory_depends_on": "eval:doc.auto_clear"
  }
 ],
 "permissions": [
  {
   "role": "System Manager",
   "read": 1,
   "write": 1,
   "create": 1,
   "delete": 1,
   "report": 1,
   "import": 1,
   "export": 1
  },
  {
   "role": "Restaurant Manager",
   "read": 1,
   "write": 1,
   "create": 1,
   "delete": 1,
   "report": 1
  }
 ],
 "actions": [],
 "links": [],
 "states": [],
 "title_field": "display_name",
 "search_fields": "display_name",
 "sort_field": "display_name",
 "sort_order": "ASC"
}
