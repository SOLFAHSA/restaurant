{
 "doctype": "DocType",
 "name": "Restaurant Area",
 "module": "Restaurant",
 "custom": 0,
 "autoname": "field:area_name",
 "naming_rule": "By fieldname",
 "allow_import": 1,
 "allow_rename": 1,
 "track_changes": 1,
 "engine": "InnoDB",
 "field_order": [
  "location_details",
  "area_name",
  "branch",
  "display_order",
  "capacity",
  "status",
  "visible_in_pos",
  "description",
  "image",
  "icon",
  "operational_settings",
  "printer",
  "waiter",
  "allow_open_accounts",
  "color",
  "notes"
 ],
 "fields": [
  {
   "fieldname": "location_details",
   "fieldtype": "Section Break",
   "label": "Información del área"
  },
  {
   "fieldname": "area_name",
   "fieldtype": "Data",
   "label": "Nombre del área",
   "reqd": 1,
   "in_list_view": 1,
   "unique": 1
  },
  {
   "fieldname": "branch",
   "fieldtype": "Link",
   "label": "Sucursal",
   "options": "Branch",
   "reqd": 1,
   "in_list_view": 1,
   "in_standard_filter": 1
  },
  {
   "fieldname": "display_order",
   "fieldtype": "Int",
   "label": "Orden de visualización",
   "default": "0",
   "non_negative": 1,
   "description": "Los números menores aparecen primero en el listado de áreas."
  },
  {
   "fieldname": "capacity",
   "fieldtype": "Int",
   "label": "Capacidad estimada",
   "reqd": 1,
   "non_negative": 1,
   "description": "Número aproximado de personas en esta área."
  },
  {
   "fieldname": "status",
   "fieldtype": "Select",
   "label": "Estado",
   "options": "Activa\nInactiva",
   "default": "Activa",
   "reqd": 1,
   "in_list_view": 1,
   "in_standard_filter": 1
  },
  {
   "fieldname": "visible_in_pos",
   "fieldtype": "Check",
   "label": "Visible en POS",
   "default": "1"
  },
  {
   "fieldname": "description",
   "fieldtype": "Small Text",
   "label": "Descripción"
  },
  {
   "fieldname": "image",
   "fieldtype": "Attach Image",
   "label": "Imagen representativa"
  },
  {
   "fieldname": "icon",
   "fieldtype": "Select",
   "label": "Icono",
   "options": "Terraza\nSalón\nBarra\nJardín",
   "default": "Terraza",
   "reqd": 1
  },
  {
   "fieldname": "operational_settings",
   "fieldtype": "Section Break",
   "label": "Configuración operativa"
  },
  {
   "fieldname": "printer",
   "fieldtype": "Link",
   "label": "Impresora asignada",
   "options": "Network Printer Settings"
  },
  {
   "fieldname": "waiter",
   "fieldtype": "Link",
   "label": "Mesero responsable",
   "options": "Employee"
  },
  {
   "fieldname": "allow_open_accounts",
   "fieldtype": "Check",
   "label": "Permite apertura de cuentas",
   "default": "1"
  },
  {
   "fieldname": "color",
   "fieldtype": "Color",
   "label": "Color de referencia",
   "default": "#22C55E"
  },
  {
   "fieldname": "notes",
   "fieldtype": "Small Text",
   "label": "Observaciones"
  }
 ],
 "permissions": [
  {
   "role": "System Manager",
   "read": 1,
   "write": 1,
   "create": 1,
   "delete": 1,
   "report": 1,
   "export": 1,
   "import": 1
  },
  {
   "role": "Restaurant Manager",
   "read": 1,
   "write": 1,
   "create": 1,
   "delete": 1,
   "report": 1
  }
 ],
 "actions": [],
 "links": [],
 "states": [],
 "sort_field": "display_order",
 "sort_order": "ASC",
 "title_field": "area_name",
 "search_fields": "area_name,branch",
 "quick_entry": 0
}
