{
 "doctype": "DocType",
 "name": "Restaurant Order Preset",
 "module": "Restaurant",
 "custom": 0,
 "autoname": "field:preset_name",
 "allow_import": 1,
 "track_changes": 1,
 "engine": "InnoDB",
 "field_order": [
  "preset_name",
  "color_bg",
  "color_border",
  "is_default",
  "enabled",
  "behavior_section",
  "require_customer",
  "enable_scheduling",
  "col_break_sched",
  "slot_interval_minutes",
  "schedule_start_time",
  "schedule_end_time"
 ],
 "fields": [
  {
   "fieldname": "preset_name",
   "fieldtype": "Data",
   "label": "Nombre del ajuste",
   "reqd": 1,
   "unique": 1,
   "in_list_view": 1
  },
  {
   "fieldname": "color_bg",
   "fieldtype": "Color",
   "label": "Color de fondo",
   "default": "#cce3fd",
   "reqd": 1,
   "in_list_view": 1
  },
  {
   "fieldname": "color_border",
   "fieldtype": "Color",
   "label": "Color de borde",
   "default": "#3b82f6",
   "reqd": 1,
   "in_list_view": 1
  },
  {
   "fieldname": "is_default",
   "fieldtype": "Check",
   "label": "Por defecto",
   "default": "0",
   "in_list_view": 1
  },
  {
   "fieldname": "enabled",
   "fieldtype": "Check",
   "label": "Habilitado",
   "default": "1",
   "in_list_view": 1
  },
  {
   "fieldname": "behavior_section",
   "fieldtype": "Section Break",
   "label": "Reglas Operativas y Programación Horaria"
  },
  {
   "fieldname": "require_customer",
   "fieldtype": "Check",
   "label": "Requerir selección de cliente en POS",
   "default": "0",
   "description": "Si está activo, al elegir esta modalidad en el POS se abrirá automáticamente el selector de cliente (ej. Entrega)."
  },
  {
   "fieldname": "enable_scheduling",
   "fieldtype": "Check",
   "label": "Habilitar programación de fecha y hora",
   "default": "0",
   "description": "Permite programar bloques de retiro o entrega (ej. Para llevar / Entrega)."
  },
  {
   "fieldname": "col_break_sched",
   "fieldtype": "Column Break"
  },
  {
   "fieldname": "slot_interval_minutes",
   "fieldtype": "Int",
   "label": "Intervalo entre horarios (minutos)",
   "default": "20"
  },
  {
   "fieldname": "schedule_start_time",
   "fieldtype": "Data",
   "label": "Hora de inicio de programación (HH:MM)",
   "default": "12:00"
  },
  {
   "fieldname": "schedule_end_time",
   "fieldtype": "Data",
   "label": "Hora de cierre de programación (HH:MM)",
   "default": "22:00"
  }
 ],
 "permissions": [
  {
   "role": "System Manager",
   "read": 1,
   "write": 1,
   "create": 1,
   "delete": 1,
   "report": 1,
   "import": 1,
   "export": 1
  },
  {
   "role": "Restaurant Manager",
   "read": 1,
   "write": 1,
   "create": 1,
   "delete": 1,
   "report": 1
  },
  {
   "role": "Restaurant User",
   "read": 1
  }
 ],
 "actions": [],
 "links": [],
 "states": [],
 "title_field": "preset_name",
 "search_fields": "preset_name",
 "sort_field": "creation",
 "sort_order": "ASC"
}

