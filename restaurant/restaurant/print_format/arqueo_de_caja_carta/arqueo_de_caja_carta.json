{
 "align_labels_right": 0,
 "creation": "2026-11-11 21:05:00.000000",
 "custom_format": 1,
 "disabled": 0,
 "doc_type": "Restaurant Cash Count",
 "doctype": "Print Format",
 "font_size": 12,
 "html": "<style>\n  @page { size: letter; margin: 14mm; }\n  .arq-letter {\n    font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Arial, sans-serif;\n    color: #0f172a;\n    font-size: 11.5px;\n    line-height: 1.45;\n  }\n  .arq-l-head {\n    display: flex;\n    justify-content: space-between;\n    align-items: flex-start;\n    border-bottom: 2px solid #0f172a;\n    padding-bottom: 12px;\n    margin-bottom: 14px;\n  }\n  .arq-l-company { font-size: 18px; font-weight: 800; color: #0f172a; margin: 0; }\n  .arq-l-doc-title { font-size: 13px; font-weight: 700; color: #0284c7; letter-spacing: 0.04em; text-transform: uppercase; margin-top: 2px; }\n  .arq-l-folio { text-align: right; }\n  .arq-l-folio-id { font-size: 15px; font-weight: 800; color: #0f172a; }\n  .arq-l-pill {\n    display: inline-block;\n    margin-top: 4px;\n    padding: 3px 12px;\n    border-radius: 999px;\n    font-size: 11px;\n    font-weight: 800;\n    text-transform: uppercase;\n    letter-spacing: 0.05em;\n  }\n  .arq-l-pill.ok { background: #dcfce7; color: #166534; border: 1px solid #86efac; }\n  .arq-l-pill.over { background: #dbeafe; color: #1e40af; border: 1px solid #93c5fd; }\n  .arq-l-pill.short { background: #fee2e2; color: #991b1b; border: 1px solid #fca5a5; }\n\n  .arq-l-meta {\n    display: grid;\n    grid-template-columns: repeat(4, 1fr);\n    gap: 8px 14px;\n    background: #f8fafc;\n    border: 1px solid #e2e8f0;\n    border-radius: 8px;\n    padding: 10px 12px;\n    margin-bottom: 14px;\n  }\n  .arq-l-meta-lbl { font-size: 9.5px; text-transform: uppercase; color: #64748b; font-weight: 700; }\n  .arq-l-meta-val { font-size: 11.5px; font-weight: 700; color: #0f172a; }\n\n  .arq-l-kpis {\n    display: grid;\n    grid-template-columns: repeat(4, 1fr);\n    gap: 10px;\n    margin-bottom: 16px;\n  }\n  .arq-l-kpi {\n    border: 1px solid #cbd5e1;\n    border-radius: 8px;\n    padding: 9px 11px;\n    background: #ffffff;\n  }\n  .arq-l-kpi-lbl { font-size: 10px; font-weight: 700; text-transform: uppercase; color: #475569; }\n  .arq-l-kpi-val { font-size: 16px; font-weight: 800; margin-top: 3px; font-variant-numeric: tabular-nums; }\n\n  .arq-l-sec {\n    font-size: 12px;\n    font-weight: 800;\n    text-transform: uppercase;\n    letter-spacing: 0.04em;\n    color: #1e293b;\n    border-left: 4px solid #0284c7;\n    padding-left: 8px;\n    margin: 14px 0 8px;\n  }\n  .arq-l-tbl {\n    width: 100%;\n    border-collapse: collapse;\n    margin-bottom: 12px;\n    font-size: 11px;\n  }\n  .arq-l-tbl th {\n    background: #f1f5f9;\n    color: #334155;\n    text-align: left;\n    padding: 6px 8px;\n    border: 1px solid #cbd5e1;\n    font-weight: 700;\n  }\n  .arq-l-tbl td {\n    padding: 6px 8px;\n    border: 1px solid #e2e8f0;\n    vertical-align: top;\n  }\n  .arq-l-tbl th.num, .arq-l-tbl td.num {\n    text-align: right;\n    font-variant-numeric: tabular-nums;\n  }\n  .arq-l-grid-2 {\n    display: grid;\n    grid-template-columns: 1.05fr 0.95fr;\n    gap: 14px;\n  }\n  .arq-l-notes {\n    background: #f8fafc;\n    border: 1px solid #e2e8f0;\n    border-radius: 6px;\n    padding: 9px 12px;\n    margin-top: 10px;\n  }\n  .arq-l-signs {\n    display: grid;\n    grid-template-columns: repeat(2, 1fr);\n    gap: 44px;\n    margin-top: 38px;\n  }\n  .arq-l-sign-box {\n    border-top: 1.5px solid #0f172a;\n    padding-top: 6px;\n    text-align: center;\n    font-size: 11px;\n  }\n</style>\n{% set pill_cls = 'ok' if doc.status == 'Cuadrado' else ('over' if doc.status == 'Sobrante' else 'short') %}\n<div class=\"arq-letter\">\n  <div class=\"arq-l-head\">\n    <div>\n      <h1 class=\"arq-l-company\">{{ doc.company or 'LEAF RESTAURANT' }}</h1>\n      <div class=\"arq-l-doc-title\">Informe Oficial de Arqueo de Caja ({{ doc.count_type }})</div>\n    </div>\n    <div class=\"arq-l-folio\">\n      <div class=\"arq-l-folio-id\">{{ doc.name }}</div>\n      <span class=\"arq-l-pill {{ pill_cls }}\">{{ doc.status or 'Pendiente' }}</span>\n    </div>\n  </div>\n\n  <div class=\"arq-l-meta\">\n    <div><div class=\"arq-l-meta-lbl\">Fecha y Hora</div><div class=\"arq-l-meta-val\">{{ frappe.utils.format_datetime(doc.posting_date, 'dd/MM/yyyy HH:mm') }}</div></div>\n    <div><div class=\"arq-l-meta-lbl\">Perfil POS</div><div class=\"arq-l-meta-val\">{{ doc.pos_profile or '-' }}</div></div>\n    <div><div class=\"arq-l-meta-lbl\">Turno Apertura POS</div><div class=\"arq-l-meta-val\">{{ doc.pos_opening_shift or '-' }}</div></div>\n    <div><div class=\"arq-l-meta-lbl\">Cajero Responsable</div><div class=\"arq-l-meta-val\">{{ doc.cashier_name or doc.cashier }}</div></div>\n    <div><div class=\"arq-l-meta-lbl\">Facturas del Turno</div><div class=\"arq-l-meta-val\">{{ doc.invoice_count or 0 }}</div></div>\n    <div><div class=\"arq-l-meta-lbl\">Ventas Facturadas</div><div class=\"arq-l-meta-val\">{{ frappe.utils.fmt_money(doc.total_sales, currency=doc.currency) }}</div></div>\n    <div><div class=\"arq-l-meta-lbl\">Mov. Efectivo Neto</div><div class=\"arq-l-meta-val\">{{ frappe.utils.fmt_money(doc.net_cash_movement, currency=doc.currency) }}</div></div>\n    <div><div class=\"arq-l-meta-lbl\">Cierre POS Vinculado</div><div class=\"arq-l-meta-val\">{{ doc.pos_closing_shift or 'Arqueo Parcial' }}</div></div>\n  </div>\n\n  <div class=\"arq-l-kpis\">\n    <div class=\"arq-l-kpi\">\n      <div class=\"arq-l-kpi-lbl\">Total Esperado Sistema</div>\n      <div class=\"arq-l-kpi-val\">{{ frappe.utils.fmt_money(doc.total_expected, currency=doc.currency) }}</div>\n    </div>\n    <div class=\"arq-l-kpi\">\n      <div class=\"arq-l-kpi-lbl\">Efectivo Físico Contado</div>\n      <div class=\"arq-l-kpi-val\">{{ frappe.utils.fmt_money(doc.cash_counted_total, currency=doc.currency) }}</div>\n    </div>\n    <div class=\"arq-l-kpi\">\n      <div class=\"arq-l-kpi-lbl\">Total General Contado</div>\n      <div class=\"arq-l-kpi-val\">{{ frappe.utils.fmt_money(doc.total_counted, currency=doc.currency) }}</div>\n    </div>\n    <div class=\"arq-l-kpi\">\n      <div class=\"arq-l-kpi-lbl\">Diferencia ({{ doc.status }})</div>\n      <div class=\"arq-l-kpi-val\">{{ frappe.utils.fmt_money(doc.total_difference, currency=doc.currency) }}</div>\n    </div>\n  </div>\n\n  <div class=\"arq-l-sec\">1. Conciliación por Método de Pago</div>\n  <table class=\"arq-l-tbl\">\n    <thead>\n      <tr>\n        <th>Método de Pago</th>\n        <th class=\"num\">Apertura</th>\n        <th class=\"num\">Ventas</th>\n        <th class=\"num\">Ingresos</th>\n        <th class=\"num\">Egresos</th>\n        <th class=\"num\">Esperado</th>\n        <th class=\"num\">Contado</th>\n        <th class=\"num\">Diferencia</th>\n      </tr>\n    </thead>\n    <tbody>\n      {% for m in doc.payment_methods %}\n      <tr>\n        <td><strong>{{ m.mode_of_payment }}</strong></td>\n        <td class=\"num\">{{ frappe.utils.fmt_money(m.opening_amount, currency=doc.currency) }}</td>\n        <td class=\"num\">{{ frappe.utils.fmt_money(m.sales_amount, currency=doc.currency) }}</td>\n        <td class=\"num\">{{ frappe.utils.fmt_money(m.income_amount, currency=doc.currency) }}</td>\n        <td class=\"num\">{{ frappe.utils.fmt_money(m.expense_amount, currency=doc.currency) }}</td>\n        <td class=\"num\"><strong>{{ frappe.utils.fmt_money(m.expected_amount, currency=doc.currency) }}</strong></td>\n        <td class=\"num\"><strong>{{ frappe.utils.fmt_money(m.counted_amount, currency=doc.currency) }}</strong></td>\n        <td class=\"num\"><strong>{{ frappe.utils.fmt_money(m.difference, currency=doc.currency) }}</strong></td>\n      </tr>\n      {% endfor %}\n    </tbody>\n  </table>\n\n  {% if doc.payment_details %}\n  <div class=\"arq-l-sec\">Detalle de Tarjetas, Transferencias y Otros</div>\n  <table class=\"arq-l-tbl\">\n    <thead>\n      <tr>\n        <th>Método de Pago</th>\n        <th>POS / Nombre del Banco</th>\n        <th>Referencia</th>\n        <th class=\"num\">Monto</th>\n      </tr>\n    </thead>\n    <tbody>\n      {% for pd in doc.payment_details %}\n      <tr>\n        <td><strong>{{ pd.mode_of_payment }}</strong></td>\n        <td>{{ pd.pos_terminal or pd.bank_name or '-' }}</td>\n        <td>{{ pd.reference or '-' }}</td>\n        <td class=\"num\"><strong>{{ frappe.utils.fmt_money(pd.amount, currency=doc.currency) }}</strong></td>\n      </tr>\n      {% endfor %}\n    </tbody>\n  </table>\n  {% endif %}\n\n  <div class=\"arq-l-grid-2\">\n    <div>\n      <div class=\"arq-l-sec\">2. Conteo Físico de Efectivo (HNL)</div>\n      <table class=\"arq-l-tbl\">\n        <thead>\n          <tr>\n            <th>Tipo</th>\n            <th>Denominación</th>\n            <th class=\"num\">Cantidad</th>\n            <th class=\"num\">Subtotal</th>\n          </tr>\n        </thead>\n        <tbody>\n          {% for d in doc.denominations if (d.quantity or 0) > 0 %}\n          <tr>\n            <td>{{ d.denomination_type }}</td>\n            <td>{{ d.denomination_label }}</td>\n            <td class=\"num\">{{ d.quantity }}</td>\n            <td class=\"num\">{{ frappe.utils.fmt_money(d.subtotal, currency=doc.currency) }}</td>\n          </tr>\n          {% else %}\n          <tr><td colspan=\"4\" style=\"text-align:center; color:#64748b;\">Sin denominaciones registradas con cantidad mayor a cero.</td></tr>\n          {% endfor %}\n        </tbody>\n        <tfoot>\n          <tr>\n            <th colspan=\"3\">Total Efectivo Físico (Billetes)</th>\n            <th class=\"num\">{{ frappe.utils.fmt_money(doc.cash_counted_total, currency=doc.currency) }}</th>\n          </tr>\n        </tfoot>\n      </table>\n    </div>\n\n    <div>\n      <div class=\"arq-l-sec\">3. Movimientos de Efectivo (Ingresos / Egresos)</div>\n      <table class=\"arq-l-tbl\">\n        <thead>\n          <tr>\n            <th>Tipo</th>\n            <th>Referencia</th>\n            <th>Motivo / Descripción</th>\n            <th class=\"num\">Monto</th>\n          </tr>\n        </thead>\n        <tbody>\n          {% for mv in doc.cash_movements %}\n          <tr>\n            <td><strong>{{ mv.movement_type }}</strong></td>\n            <td>{{ mv.cash_movement_ref or '-' }}</td>\n            <td>{{ mv.note or '-' }}</td>\n            <td class=\"num\">{{ frappe.utils.fmt_money(mv.amount, currency=doc.currency) }}</td>\n          </tr>\n          {% else %}\n          <tr><td colspan=\"4\" style=\"text-align:center; color:#64748b;\">No se registraron ingresos ni egresos en este turno.</td></tr>\n          {% endfor %}\n        </tbody>\n        <tfoot>\n          <tr>\n            <th colspan=\"3\">Total Ingresos Extra (+)</th>\n            <th class=\"num\">{{ frappe.utils.fmt_money(doc.total_income, currency=doc.currency) }}</th>\n          </tr>\n          <tr>\n            <th colspan=\"3\">Total Egresos / Retiros (-)</th>\n            <th class=\"num\">{{ frappe.utils.fmt_money(doc.total_expense, currency=doc.currency) }}</th>\n          </tr>\n        </tfoot>\n      </table>\n    </div>\n  </div>\n\n  {% if doc.notes %}\n  <div class=\"arq-l-notes\">\n    <strong>Observaciones del Arqueo:</strong> {{ doc.notes }}\n  </div>\n  {% endif %}\n\n  <div class=\"arq-l-signs\">\n    <div class=\"arq-l-sign-box\">\n      <strong>{{ doc.cashier_name or doc.cashier }}</strong><br>\n      Cajero Responsable — Entrega\n    </div>\n    <div class=\"arq-l-sign-box\">\n      <strong>Supervisión / Gerencia</strong><br>\n      Recibe y Valida el Arqueo\n    </div>\n  </div>\n</div>",
