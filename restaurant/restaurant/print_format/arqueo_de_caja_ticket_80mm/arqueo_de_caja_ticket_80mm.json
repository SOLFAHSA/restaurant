{
 "align_labels_right": 0,
 "creation": "2026-11-11 21:05:00.000000",
 "custom_format": 1,
 "disabled": 0,
 "doc_type": "Restaurant Cash Count",
 "doctype": "Print Format",
 "font_size": 11,
 "html": "<style>\n  @page { size: 80mm auto; margin: 4mm; }\n  .arq-ticket {\n    width: 72mm;\n    max-width: 72mm;\n    margin: 0 auto;\n    font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, monospace;\n    font-size: 11px;\n    line-height: 1.35;\n    color: #111827;\n  }\n  .arq-ticket-center { text-align: center; }\n  .arq-ticket-title { font-size: 14px; font-weight: 800; letter-spacing: 0.04em; margin: 2px 0; }\n  .arq-ticket-sub { font-size: 10px; color: #374151; }\n  .arq-ticket-hr { border: 0; border-top: 1px dashed #6b7280; margin: 7px 0; }\n  .arq-ticket-badge {\n    display: inline-block;\n    padding: 3px 10px;\n    margin: 4px 0;\n    border: 1.5px solid #111827;\n    border-radius: 999px;\n    font-size: 11px;\n    font-weight: 800;\n    text-transform: uppercase;\n    letter-spacing: 0.05em;\n  }\n  .arq-ticket-kv { width: 100%; border-collapse: collapse; font-size: 10.5px; }\n  .arq-ticket-kv td { padding: 1.5px 0; vertical-align: top; }\n  .arq-ticket-kv td:last-child { text-align: right; font-weight: 600; }\n  .arq-ticket-sec {\n    font-size: 10.5px;\n    font-weight: 800;\n    text-transform: uppercase;\n    letter-spacing: 0.04em;\n    margin: 6px 0 3px;\n  }\n  .arq-ticket-tbl { width: 100%; border-collapse: collapse; font-size: 10px; }\n  .arq-ticket-tbl th {\n    text-align: left;\n    border-bottom: 1px solid #374151;\n    padding: 2px 0;\n    font-weight: 700;\n  }\n  .arq-ticket-tbl th.num, .arq-ticket-tbl td.num { text-align: right; font-variant-numeric: tabular-nums; }\n  .arq-ticket-tbl td { padding: 2.5px 0; border-bottom: 1px dotted #d1d5db; vertical-align: top; }\n  .arq-ticket-total-box {\n    border: 1px solid #111827;\n    border-radius: 4px;\n    padding: 5px 7px;\n    margin: 6px 0;\n    background: #f9fafb;\n  }\n  .arq-ticket-sign {\n    margin-top: 22px;\n    padding-top: 4px;\n    border-top: 1px solid #111827;\n    text-align: center;\n    font-size: 10px;\n  }\n</style>\n<div class=\"arq-ticket\">\n  <div class=\"arq-ticket-center\">\n    <div class=\"arq-ticket-title\">{{ doc.company or 'LEAF RESTAURANT' }}</div>\n    <div class=\"arq-ticket-sub\">COMPROBANTE DE ARQUEO DE CAJA</div>\n    <div style=\"font-weight:700; font-size:12px; margin-top:2px;\">{{ doc.name }}</div>\n    <div><span class=\"arq-ticket-badge\">{{ doc.status or 'Pendiente' }}</span></div>\n  </div>\n\n  <hr class=\"arq-ticket-hr\">\n\n  <table class=\"arq-ticket-kv\">\n    <tr><td>Tipo:</td><td>{{ doc.count_type }}</td></tr>\n    <tr><td>Fecha:</td><td>{{ frappe.utils.format_datetime(doc.posting_date, 'dd/MM/yyyy HH:mm') }}</td></tr>\n    <tr><td>Perfil POS:</td><td>{{ doc.pos_profile or '-' }}</td></tr>\n    <tr><td>Turno POS:</td><td>{{ doc.pos_opening_shift or '-' }}</td></tr>\n    {% if doc.pos_closing_shift %}\n    <tr><td>Cierre POS:</td><td>{{ doc.pos_closing_shift }}</td></tr>\n    {% endif %}\n    <tr><td>Cajero:</td><td>{{ doc.cashier_name or doc.cashier }}</td></tr>\n    <tr><td>Facturas / Ventas:</td><td>{{ doc.invoice_count or 0 }} / {{ frappe.utils.fmt_money(doc.total_sales, currency=doc.currency) }}</td></tr>\n  </table>\n\n  <div class=\"arq-ticket-total-box\">\n    <table class=\"arq-ticket-kv\">\n      <tr><td>Total Esperado:</td><td>{{ frappe.utils.fmt_money(doc.total_expected, currency=doc.currency) }}</td></tr>\n      <tr><td>Total Contado:</td><td>{{ frappe.utils.fmt_money(doc.total_counted, currency=doc.currency) }}</td></tr>\n      <tr style=\"font-size:11.5px; border-top:1px dashed #9ca3af;\">\n        <td style=\"padding-top:3px; font-weight:800;\">Diferencia:</td>\n        <td style=\"padding-top:3px; font-weight:800;\">{{ frappe.utils.fmt_money(doc.total_difference, currency=doc.currency) }}</td>\n      </tr>\n    </table>\n  </div>\n\n  <div class=\"arq-ticket-sec\">Conciliación por Método</div>\n  <table class=\"arq-ticket-tbl\">\n    <thead>\n      <tr>\n        <th>Método</th>\n        <th class=\"num\">Esp.</th>\n        <th class=\"num\">Cont.</th>\n        <th class=\"num\">Dif.</th>\n      </tr>\n    </thead>\n    <tbody>\n      {% for m in doc.payment_methods %}\n      <tr>\n        <td>{{ m.mode_of_payment }}</td>\n        <td class=\"num\">{{ '%.2f'|format(m.expected_amount or 0) }}</td>\n        <td class=\"num\">{{ '%.2f'|format(m.counted_amount or 0) }}</td>\n        <td class=\"num\">{{ '%.2f'|format(m.difference or 0) }}</td>\n      </tr>\n      {% endfor %}\n    </tbody>\n  </table>\n\n  {% if doc.payment_details %}\n  <div class=\"arq-ticket-sec\">Detalle POS / Bancos</div>\n  <table class=\"arq-ticket-tbl\">\n    <thead>\n      <tr>\n        <th>Método / Detalle</th>\n        <th>Ref.</th>\n        <th class=\"num\">Monto</th>\n      </tr>\n    </thead>\n    <tbody>\n      {% for pd in doc.payment_details %}\n      <tr>\n        <td>\n          <strong>{{ pd.mode_of_payment }}</strong>\n          {% if pd.pos_terminal or pd.bank_name %}<br><span style=\"font-size:9px; color:#4b5563;\">{{ pd.pos_terminal or pd.bank_name }}</span>{% endif %}\n        </td>\n        <td>{{ pd.reference or '-' }}</td>\n        <td class=\"num\">{{ '%.2f'|format(pd.amount or 0) }}</td>\n      </tr>\n      {% endfor %}\n    </tbody>\n  </table>\n  {% endif %}\n\n  <div class=\"arq-ticket-sec\">Desglose de Efectivo Contado</div>\n  <table class=\"arq-ticket-tbl\">\n    <thead>\n      <tr>\n        <th>Denominación</th>\n        <th class=\"num\">Cant.</th>\n        <th class=\"num\">Subtotal</th>\n      </tr>\n    </thead>\n    <tbody>\n      {% for d in doc.denominations if (d.quantity or 0) > 0 %}\n      <tr>\n        <td>{{ d.denomination_label }}</td>\n        <td class=\"num\">{{ d.quantity }}</td>\n        <td class=\"num\">{{ '%.2f'|format(d.subtotal or 0) }}</td>\n      </tr>\n      {% endfor %}\n    </tbody>\n  </table>\n  <table class=\"arq-ticket-kv\" style=\"margin-top:4px;\">\n    <tr><td><strong>Efectivo Físico (Billetes):</strong></td><td><strong>{{ frappe.utils.fmt_money(doc.cash_counted_total, currency=doc.currency) }}</strong></td></tr>\n  </table>\n\n  {% if doc.cash_movements %}\n  <div class=\"arq-ticket-sec\">Ingresos / Egresos del Turno</div>\n  <table class=\"arq-ticket-tbl\">\n    <thead>\n      <tr>\n        <th>Tipo / Motivo</th>\n        <th class=\"num\">Monto</th>\n      </tr>\n    </thead>\n    <tbody>\n      {% for mv in doc.cash_movements %}\n      <tr>\n        <td>\n          <strong>{{ mv.movement_type }}</strong>\n          {% if mv.note %}<br><span style=\"font-size:9px;\">{{ mv.note }}</span>{% endif %}\n        </td>\n        <td class=\"num\">{{ '%.2f'|format(mv.amount or 0) }}</td>\n      </tr>\n      {% endfor %}\n    </tbody>\n  </table>\n  <table class=\"arq-ticket-kv\" style=\"margin-top:3px;\">\n    <tr><td>Ingresos Extra:</td><td>+{{ frappe.utils.fmt_money(doc.total_income, currency=doc.currency) }}</td></tr>\n    <tr><td>Egresos / Retiros:</td><td>-{{ frappe.utils.fmt_money(doc.total_expense, currency=doc.currency) }}</td></tr>\n  </table>\n  {% endif %}\n\n  {% if doc.notes %}\n  <hr class=\"arq-ticket-hr\">\n  <div style=\"font-size:10px;\"><strong>Observaciones:</strong> {{ doc.notes }}</div>\n  {% endif %}\n\n  <div class=\"arq-ticket-sign\">Firma del Cajero ({{ doc.cashier_name or doc.cashier }})</div>\n  <div class=\"arq-ticket-sign\">Vo. Bo. Supervisor / Gerencia</div>\n  <div class=\"arq-ticket-center\" style=\"margin-top:10px; font-size:9px; color:#6b7280;\">\n    Documento generado por LEAF Restaurant ERP\n  </div>\n</div>",
